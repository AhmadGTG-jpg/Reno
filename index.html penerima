
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hasil Perkenalan - Reno</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f6f7fb;
  color: #172033;
  font: 16px/1.6 system-ui, sans-serif;
}

.wrap {
  width: min(850px, calc(100% - 32px));
  margin: 48px auto;
}

.panel {
  background: white;
  border: 1px solid #e4e9f1;
  border-radius: 20px;
  padding: clamp(22px, 5vw, 38px);
  box-shadow: 0 12px 35px #1c2b4410;
}

h1 {
  margin: 0 0 6px;
  font-size: clamp(28px, 6vw, 42px);
}

.muted {
  color: #687386;
}

button {
  border: 0;
  border-radius: 11px;
  padding: 11px 16px;
  background: #6558e8;
  color: white;
  font-weight: 700;
  cursor: pointer;
  margin: 12px 8px 12px 0;
}

.entry {
  border-top: 1px solid #e4e9f1;
  padding: 18px 0;
}

.entry h2 {
  font-size: 20px;
  margin: 0 0 8px;
}

.entry p {
  margin: 6px 0;
  white-space: pre-wrap;
}

.empty {
  padding: 25px 0;
  color: #687386;
}

.warning {
  background: #fff6df;
  border-radius: 12px;
  padding: 14px;
  color: #75551a;
  font-size: 14px;
  margin-top: 20px;
}
</style>
</head>

<body>

<main class="wrap">
<section class="panel">

<h1>Hasil Perkenalan</h1>

<p class="muted">
Daftar orang yang sudah mengisi formulir
perkenalan di website Reno.
</p>

<button id="refresh">Muat ulang</button>
<button id="clear">Hapus semua data</button>

<div id="results" aria-live="polite"></div>

<div class="warning">
<strong>Catatan penting:</strong>
Versi ini menyimpan jawaban di penyimpanan
browser/perangkat yang sama. Halaman formulir
dan halaman hasil harus dibuka di browser yang sama.
</div>

</section>
</main>

<script>

const results = document.getElementById('results');

function render() {

  const rows = JSON.parse(
    localStorage.getItem('reno-introductions') || '[]'
  );

  if (!rows.length) {
    results.innerHTML =
      '<div class="empty">Belum ada perkenalan yang masuk.</div>';
    return;
  }

  results.innerHTML = rows.slice().reverse().map(x => `
    <article class="entry">

      <h2>${esc(x.name || 'Tanpa nama')}</h2>

      <p><b>Sekolah / kampus:</b> ${esc(x.school || '-')}</p>

      <p><b>Jurusan / kelas:</b> ${esc(x.major || '-')}</p>

      <p><b>Hobi:</b> ${esc(x.hobby || '-')}</p>

      <p><b>Tentang diri:</b> ${esc(x.about || '-')}</p>

      <p class="muted">
        <small>${esc(x.createdAt || '')}</small>
      </p>

    </article>
  `).join('');
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[c]));
}

document.getElementById('refresh').onclick = render;

document.getElementById('clear').onclick = () => {

  if (confirm('Yakin ingin menghapus semua data perkenalan di browser ini?')) {
    localStorage.removeItem('reno-introductions');
    render();
  }

};

render();

</script>

</body>
</html>
